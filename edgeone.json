{
  "buildCommand": "node scripts/build-data.mjs",
  "nodeVersion": "22.11.0",
  "cloudFunctions": {
    "nodejs": {
      "maxDuration": 30,
      "includeFiles": [
        "data/sites.json"
      ]
    }
  },
  "headers": [
    {
      "source": "/assets/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/data/*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
